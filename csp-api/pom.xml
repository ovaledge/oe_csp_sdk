<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.ovaledge</groupId>
        <artifactId>oe-csp-sdk</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>csp-api</artifactId>
    <packaging>jar</packaging>
    <name>oe-csp-api</name>
    <description>Unified REST API gateway for CSP SDK connectors. Automatically discovers connectors via ServiceLoader and provides connection validation, metadata extraction, and query execution with dynamic routing based on serverType.</description>
    <properties>
        <maven.build.timestamp.format>yyyyMMddHHmmss</maven.build.timestamp.format>
    </properties>
    <dependencies>
        <!-- Core dependencies -->
        <dependency>
            <groupId>com.ovaledge</groupId>
            <artifactId>csp-sdk-core</artifactId>
        </dependency>

        <!-- Connector archetype templates reused by the UI generator -->
        <dependency>
            <groupId>com.ovaledge</groupId>
            <artifactId>oe-csp-connector-archetype</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Connector dependencies - these will be discovered via ServiceLoader -->
        <dependency>
            <groupId>com.ovaledge</groupId>
            <artifactId>monetdb</artifactId>
        </dependency>
        <dependency>
            <groupId>com.ovaledge</groupId>
            <artifactId>awsconsole</artifactId>
        </dependency>

        <dependency>
            <groupId>com.ovaledge</groupId>
            <artifactId>zohodesk</artifactId>
        </dependency>
<!-- Connector generator marker (dependencies): DO NOT REMOVE. New connector dependencies are inserted above this line. -->

        <!--
          Parses the repository root pom.xml (&lt;modules&gt;) at runtime for SdkConnectorReactorScanner.
          Used to discover in-repo SDK connector modules when building the blocked/owned serverType sets
          (Connector Generator validation and GET /v1/generator/reserved-server-types). Not used at test scope only
          because the scanner ships in the main csp-api artifact.
        -->
        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-model</artifactId>
        </dependency>

        <!-- Spring Boot -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>ch.qos.logback</groupId>
                    <artifactId>logback-classic</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.apache.logging.log4j</groupId>
                    <artifactId>log4j-core</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.apache.logging.log4j</groupId>
                    <artifactId>log4j-api</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.apache.logging.log4j</groupId>
                    <artifactId>log4j-to-slf4j</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>ch.qos.logback</groupId>
                    <artifactId>logback-classic</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.apache.logging.log4j</groupId>
                    <artifactId>log4j-core</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.apache.logging.log4j</groupId>
                    <artifactId>log4j-api</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.apache.logging.log4j</groupId>
                    <artifactId>log4j-to-slf4j</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Logging - matching csp-api from oe_csp_apps: Log4j2 implementation required by Spring Boot's Log4J2LoggingSystem -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-log4j12</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
        </dependency>
        
        <!-- Test Dependencies -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-inline</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.qameta.allure</groupId>
            <artifactId>allure-junit5</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>static/index.html</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>static/index.html</exclude>
                </excludes>
            </resource>
            <!-- Ensure SDK release metadata is available to the generator at runtime -->
            <resource>
                <directory>../assembly/src/main/resources</directory>
                <filtering>false</filtering>
                <includes>
                    <include>release-csp-sdk.properties</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <testExcludes>
                        <testExclude>com/ovaledge/csp/tests/deprecated/**</testExclude>
                    </testExcludes>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <skipTests>${csp.sdk.build.skip.tests}</skipTests>
                    <includes>
                        <include>**/*Test.java</include>
                    </includes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <!--
                                    Fix for dnsjava ServiceLoader failure in shaded JAR:

                                    dnsjava (pulled transitively via Hadoop) uses a Java 18+ SPI
                                    (InetAddressResolverProvider) whose implementation class exists only in
                                    META-INF/versions/ (multi-release JAR).

                                    When building an uber JAR with maven-shade-plugin, the manifest did not include
                                    "Multi-Release: true", so the JVM ignored versioned classes and failed to load:
                                    org.xbill.DNS.spi.DnsjavaInetAddressResolverProvider

                                    Adding "Multi-Release: true" ensures JVM loads classes from META-INF/versions/*
                                    as per JEP 238 and fixes the issue.
                                -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.ovaledge.csp.apps.app.CspAppsApiApplication</mainClass>
                                    <manifestEntries>
                                        <Multi-Release>true</Multi-Release>
                                    </manifestEntries>
                                </transformer>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                                <filter>
                                    <artifact>ch.qos.logback:logback-classic</artifact>
                                    <excludes>
                                        <exclude>**</exclude>
                                    </excludes>
                                </filter>
                                <filter>
                                    <artifact>ch.qos.logback:logback-core</artifact>
                                    <excludes>
                                        <exclude>**</exclude>
                                    </excludes>
                                </filter>
                                <filter>
                                    <artifact>org.slf4j:slf4j-reload4j</artifact>
                                    <excludes>
                                        <exclude>**</exclude>
                                    </excludes>
                                </filter>
                                <filter>
                                    <artifact>org.slf4j:slf4j-log4j12</artifact>
                                    <excludes>
                                        <exclude>**</exclude>
                                    </excludes>
                                </filter>
                                <filter>
                                    <artifact>org.slf4j:slf4j-nop</artifact>
                                    <excludes>
                                        <exclude>**</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <profiles>
    <profile>
      <id>unit-tests</id>
      <properties>
        <csp.sdk.build.skip.tests>false</csp.sdk.build.skip.tests>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <skipTests>false</skipTests>
              <includes>
                <include>**/tests/unit/**/*Test.java</include>
                <include>**/tests/unit/**/*Tests.java</include>
              </includes>
              <excludes>
                <exclude>**/tests/e2e/**/*Test.java</exclude>
                <exclude>**/tests/integration/**/*Test.java</exclude>
              </excludes>
              <systemPropertyVariables>
                <testcontainers.disabled>true</testcontainers.disabled>
                <allure.results.directory>${project.build.directory}/allure-results</allure.results.directory>
              </systemPropertyVariables>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>integration-tests</id>
      <properties>
        <csp.sdk.build.skip.tests>false</csp.sdk.build.skip.tests>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <skipTests>false</skipTests>
              <includes>
                <include>**/tests/integration/**/*Test.java</include>
                <include>**/tests/integration/**/*Tests.java</include>
              </includes>
              <excludes>
                <exclude>**/tests/e2e/**/*Test.java</exclude>
                <exclude>**/tests/unit/**/*Test.java</exclude>
              </excludes>
              <systemPropertyVariables>
                <testcontainers.disabled>false</testcontainers.disabled>
                <jdbc.drivers></jdbc.drivers>
                <allure.results.directory>${project.build.directory}/allure-results</allure.results.directory>
              </systemPropertyVariables>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>unit-and-integration-tests</id>
      <properties>
        <csp.sdk.build.skip.tests>false</csp.sdk.build.skip.tests>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <skipTests>false</skipTests>
              <includes>
                <include>**/tests/unit/**/*Test.java</include>
                <include>**/tests/unit/**/*Tests.java</include>
                <include>**/tests/integration/**/*Test.java</include>
                <include>**/tests/integration/**/*Tests.java</include>
              </includes>
              <excludes>
                <exclude>**/tests/e2e/**/*Test.java</exclude>
              </excludes>
              <systemPropertyVariables>
                <testcontainers.disabled>false</testcontainers.disabled>
                <jdbc.drivers></jdbc.drivers>
                <allure.results.directory>${project.build.directory}/allure-results</allure.results.directory>
              </systemPropertyVariables>
            </configuration>
          </plugin>
          <plugin>
            <groupId>org.jacoco</groupId>
            <artifactId>jacoco-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>prepare-agent</id>
                <goals><goal>prepare-agent</goal></goals>
              </execution>
              <execution>
                <id>report</id>
                <phase>test</phase>
                <goals><goal>report</goal></goals>
                <configuration>
                  <outputDirectory>${project.build.directory}/site/jacoco</outputDirectory>
                  <dataFile>${project.build.directory}/jacoco.exec</dataFile>
                </configuration>
              </execution>
            </executions>
            <configuration>
              <destFile>${project.build.directory}/jacoco.exec</destFile>
              <dataFile>${project.build.directory}/jacoco.exec</dataFile>
            </configuration>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-report-plugin</artifactId>
            <executions>
              <execution>
                <id>generate-report</id>
                <phase>test</phase>
                <goals><goal>report-only</goal></goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>io.qameta.allure</groupId>
            <artifactId>allure-maven</artifactId>
            <executions>
              <execution>
                <id>allure-report</id>
                <phase>verify</phase>
                <goals><goal>report</goal></goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>consolidate-test-reports</id>
                <phase>verify</phase>
                <goals><goal>exec</goal></goals>
                <configuration>
                  <executable>bash</executable>
                  <arguments>
                    <argument>${session.executionRootDirectory}/assembly/src/test/resources/scripts/consolidate-test-reports.sh</argument>
                    <argument>${session.executionRootDirectory}</argument>
                    <argument>${csp.sdk.consolidated.reports.dir}</argument>
                    <argument>${csp.sdk.test.report.modules}</argument>
                    <argument>oe_csp_sdk</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    </profiles>
</project>
